  "info": {
    "title": "Dash4 API",
    "description": "투명 후불제 MVP 제작 서비스 API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "client@example.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "FoodTech MVP"
          },
          "clientId": {
            "type": "string"
          },
          "githubRepoUrl": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "clientId"
        ]
      },
      "UpdateStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "W1",
              "W2",
              "W3",
              "W4",
              "DONE",
              "PAUSED"
            ]
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}